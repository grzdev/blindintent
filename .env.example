# Network target: testnet (qorechain-diana) or mainnet (qorechain-vladi)
QORE_NETWORK=testnet
QORE_CHAIN_ID=qorechain-diana
QORE_REST_URL=https://api-testnet.qore.host
QORE_RPC_URL=https://rpc-testnet.qore.host
QORE_EVM_RPC_URL=https://evm-testnet.qore.host

# Fresh TESTNET-ONLY keys (generated locally via `npm run sandbox:keygen`; NEVER put mainnet keys here!)
DEPLOYER_PRIVATE_KEY=
DEPLOYER_MNEMONIC=
SANDBOX_OWNER_MNEMONIC=
SANDBOX_AGENT_MNEMONIC=
SANDBOX_RELAYER_MNEMONIC=

# Deployed contract address on qorechain-diana EVM (populated after deploy)
VITE_VAULT_ADDRESS=
VAULT_ADDRESS=

# Fest Testnet ERC-20 tokens on qorechain-diana
FUSD_ERC20=0x97143B771D34ddb9130b807b135Ae675A5a963CA
FETH_ERC20=0x02292293c13880a26242690eb70a0e42B8E91c28
FBTC_ERC20=0x4604e7E45b2ecdbfbDc157103f5B2b62cb16451A

# Optional LLM API key for free-form natural-language intent compilation
# Falls back to deterministic structured parser automatically if unset
GEMINI_API_KEY=
OPENAI_API_KEY=

PORT=8787
