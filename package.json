{
  "name": "blindintent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "BlindIntent — MEV-proof, post-quantum sealed trading intents executed by policy-capped AI agents on QoreChain.",
  "workspaces": [
    "contracts",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --workspace=contracts run build && npm --workspace=server run typecheck && npm --workspace=web run build",
    "test": "npm --workspace=contracts run test && npm --workspace=server run test",
    "contracts:build": "npm --workspace=contracts run build",
    "contracts:test": "npm --workspace=contracts run test",
    "sandbox:keygen": "npm --workspace=server run sandbox:keygen",
    "sandbox:init": "npm --workspace=server run sandbox:init",
    "live:launch": "npm --workspace=server run live:launch",
    "server:dev": "npm --workspace=server run dev",
    "web:dev": "npm --workspace=web run dev"
  },
  "dependencies": {
    "@qorechain/evm": "^0.14.0",
    "@qorechain/mcp": "^0.1.1",
    "@qorechain/pqc": "^0.2.3",
    "@qorechain/qoreseal": "^0.1.0",
    "@qorechain/qoresign": "^0.2.0",
    "@qorechain/react": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  }
}
